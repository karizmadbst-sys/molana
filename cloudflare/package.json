{
  "name": "echo-cloudflare-multiplayer",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers + Durable Objects + D1 real-time multiplayer backend for ECHO - The World Remembers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute echo-multiplayer-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute echo-multiplayer-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250401.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.10.0"
  }
}
