{
  "name": "echo-the-world-remembers",
  "private": true,
  "version": "1.0.0",
  "description": "ECHO – THE WORLD REMEMBERS: A mystical 3D third-person adventure across the Forgotten Island.",
  "author": "ECHO Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cap:sync": "cap sync android",
    "build:android": "vite build && cap sync android",
    "electron:start": "vite build && electron .",
    "build:win": "vite build && electron-builder --win nsis portable --x64 --publish never",
    "build:win:portable": "vite build && electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "com.echo.theworldremembers",
    "productName": "ECHO - The World Remembers",
    "copyright": "Copyright © 2026 ECHO",
    "directories": {
      "buildResources": "electron",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ECHO-The-World-Remembers-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "ECHO-The-World-Remembers-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ECHO - The World Remembers"
    },
    "portable": {
      "artifactName": "ECHO-The-World-Remembers-Portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@dimforge/rapier3d-simd-compat": "^0.19.3",
    "@google/genai": "^2.7.0",
    "@mediapipe/tasks-audio": "^0.10.35",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@pmndrs/uikit": "^1.0.64",
    "@preact/signals-core": "^1.14.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2",
    "express": "^5.3.0",
    "lit": "^3.3.1",
    "openai": "^6.7.0",
    "three": "~0.186.0",
    "three-mesh-bvh": "^0.9.10",
    "three-pathfinding": "^1.3.0",
    "troika-three-text": "^0.52.4",
    "tslib": "^2.8.1",
    "ws": "^8.23.0",
    "xrblocks": "~0.24.0"
  },
  "devDependencies": {
    "@types/dom-speech-recognition": "^0.0.7",
    "@types/node": "^25.0.8",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "troika-types": "^0.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
