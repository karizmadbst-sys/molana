# Multiplayer Client Configuration (Used by Vite & GitHub Pages Build)
# Set these in your GitHub Repository -> Settings -> Secrets and variables -> Actions -> Variables

# WebSocket URL of your deployed Cloudflare Worker (wss://.../ws)
VITE_MULTIPLAYER_WS_URL=

# HTTP API URL of your deployed Cloudflare Worker (https://...)
VITE_MULTIPLAYER_API_URL=
